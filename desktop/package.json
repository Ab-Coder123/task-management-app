{
  "name": "tasksaas-desktop",
  "version": "1.0.0",
  "description": "TaskSaaS Native Desktop Application for Teams and Companies",
  "author": {
    "name": "TaskSaaS",
    "email": "support@tasksaas.app"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "dmg-builder"
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tasksaas.desktop",
    "productName": "TaskSaaS",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ab-Coder123",
        "repo": "task-management-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "TaskSaaS-Setup-Win-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskSaaS"
    },
    "portable": {
      "artifactName": "TaskSaaS-Portable-Win-x64.${ext}"
    },
    "mac": {
      "artifactName": "TaskSaaS-macOS.${ext}",
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "artifactName": "TaskSaaS-Linux.${ext}",
      "maintainer": "TaskSaaS <support@tasksaas.app>",
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
